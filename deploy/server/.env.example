# The hostname browsers, desktops and MCP clients reach. Point its DNS at this machine first:
# Caddy needs ports 80 and 443 open to get a certificate.
AIRPOST_DOMAIN=airpost.example.com

# The airpost-server image version. Change it, then `docker compose pull && docker compose up -d`,
# to upgrade.
AIRPOST_VERSION=0.1.0

# What runs besides the engine, comma-separated:
#   web      airpost-gateway and the web client
#   proxy    Caddy, with a certificate for AIRPOST_DOMAIN (leave it out behind your own proxy)
#   backend  airpost-backend; no client uses it yet, so leave it off
#   mcp      airpost-mcp over HTTP at https://AIRPOST_DOMAIN/mcp; mcp.json sets what agents may do
COMPOSE_PROFILES=web,proxy

# The URL clients use, when it isn't https://AIRPOST_DOMAIN (a non-standard port, or a local
# trial: http://127.0.0.1:5180 with compose.own-proxy.yaml).
# AIRPOST_PUBLIC_URL=https://airpost.example.com

# backend: closed creates users with `docker compose exec backend airpost-backend user add`; open
# lets anyone who can reach the server sign up.
AIRPOST_SIGNUP=closed
# backend: scheduled backups in the backend-backups volume.
AIRPOST_BACKUP_INTERVAL=24h
AIRPOST_BACKUP_KEEP=14
# backend: text or json.
AIRPOST_LOG_FORMAT=text

# Your own OAuth clients for Gmail and Microsoft 365; empty uses the built-in ones.
# AIRPOST_GMAIL_CLIENT_ID=
# AIRPOST_GMAIL_CLIENT_SECRET=
# AIRPOST_O365_CLIENT_ID=

# The compose network. Change it only if it collides with a network this machine already uses.
AIRPOST_SUBNET=172.31.86.0/24
