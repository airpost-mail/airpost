# The hostname browsers, desktops and MCP clients reach. Point its DNS at this machine first:
# Caddy needs ports 80 and 443 open to get a certificate.
TERN_DOMAIN=tern.example.com

# The tern-server image version. Change it, then `docker compose pull && docker compose up -d`,
# to upgrade.
TERN_VERSION=0.1.0

# What runs besides the engine, comma-separated:
#   web      tern-gateway and the web client
#   proxy    Caddy, with a certificate for TERN_DOMAIN (leave it out behind your own proxy)
#   backend  tern-backend: metadata sync between desktops, tracking
#   mcp      tern-mcp over HTTP at https://TERN_DOMAIN/mcp; mcp.json sets what agents may do
COMPOSE_PROFILES=web,proxy

# The URL clients use, when it isn't https://TERN_DOMAIN (a non-standard port, or a local
# trial: http://127.0.0.1:5180 with compose.own-proxy.yaml).
# TERN_PUBLIC_URL=https://tern.example.com

# backend: closed creates users with `docker compose exec backend tern-backend user add`; open
# lets anyone who can reach the server sign up.
TERN_SIGNUP=closed
# backend: scheduled backups in the backend-backups volume.
TERN_BACKUP_INTERVAL=24h
TERN_BACKUP_KEEP=14
# backend: text or json.
TERN_LOG_FORMAT=text

# Your own OAuth clients for Gmail and Microsoft 365; empty uses the built-in ones.
# TERN_GMAIL_CLIENT_ID=
# TERN_GMAIL_CLIENT_SECRET=
# TERN_O365_CLIENT_ID=

# The compose network. Change it only if it collides with a network this machine already uses.
TERN_SUBNET=172.31.86.0/24
