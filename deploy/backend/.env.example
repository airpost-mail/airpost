# The hostname desktops and mail recipients reach. Point its DNS at this machine first: Caddy
# needs ports 80 and 443 open to get a certificate.
AIRPOST_DOMAIN=airpost.example.com

# The airpost-backend image version. Change it, then `docker compose pull && docker compose up -d`,
# to upgrade. The backend copies its database before running a migration.
AIRPOST_VERSION=0.1.0

# closed: create users with `docker compose exec backend airpost-backend user add <email>`.
# open: anyone who can reach the server can sign up.
AIRPOST_SIGNUP=closed

# Scheduled backups in the `backups` volume. Copy them off the machine with
#   docker compose cp backend:/backups ./backups
AIRPOST_BACKUP_INTERVAL=24h
AIRPOST_BACKUP_KEEP=14

# text or json.
AIRPOST_LOG_FORMAT=text

# The compose network. Change it only if it collides with a network this machine already uses.
AIRPOST_SUBNET=172.31.85.0/24
