# Airpost backend as a system service (docs/self-hosting.md, "Without Docker").
#   useradd --system --home-dir /var/lib/airpost-backend --shell /usr/sbin/nologin airpost
#   install -m 755 airpost-backend /usr/local/bin/
#   install -d -m 755 /etc/airpost-backend
#   install -m 640 -g airpost airpost.toml /etc/airpost-backend/    # from airpost.toml.example
#   cp airpost-backend.service /etc/systemd/system/ && systemctl enable --now airpost-backend
# Admin commands run as the same user, so files they create stay readable by the server:
#   sudo -u airpost airpost-backend --config /etc/airpost-backend/airpost.toml user add you@example.com

[Unit]
Description=Airpost backend
Documentation=https://github.com/airpost-mail/airpost/blob/main/docs/self-hosting.md
After=network-online.target
Wants=network-online.target

[Service]
User=airpost
Group=airpost
ExecStart=/usr/local/bin/airpost-backend --config /etc/airpost-backend/airpost.toml serve
StateDirectory=airpost-backend
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=5

NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
