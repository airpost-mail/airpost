<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.airpost.airpost</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <name><%= productName %></name>
  <summary><%= description %></summary>
  <description>
    <p>
      Airpost is an open source desktop email client with a unified inbox, snooze, send later,
      mail rules, templates, calendar and contacts. It is a fork of Mailspring with a new sync
      engine written in Rust.
    </p>
  </description>

  <url type="homepage">https://github.com/airpost-mail/airpost</url>
  <url type="bugtracker">https://github.com/airpost-mail/airpost/issues</url>
  <url type="vcs-browser">https://github.com/airpost-mail/airpost</url>

  <launchable type="desktop-id"><%= desktopName %></launchable>

  <developer id="com.airpost">
    <name>Airpost contributors</name>
  </developer>

  <branding>
    <color type="primary" scheme_preference="light">#d7f0f8</color>
    <color type="primary" scheme_preference="dark">#0589EE</color>
  </branding>

  <content_rating type="oars-1.1" />

  <releases>
    <release version="0.1.1" date="2026-11-27" />
    <release version="0.1.0" date="2026-11-17" />
  </releases>
</component>
