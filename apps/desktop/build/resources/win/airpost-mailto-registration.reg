Windows Registry Editor Version 5.00

[{{HKEY_ROOT}}\SOFTWARE\Classes\Airpost.Url.mailto]
"FriendlyTypeName"="Airpost Url"

[{{HKEY_ROOT}}\SOFTWARE\Classes\Airpost.Url.mailto\shell]

[{{HKEY_ROOT}}\SOFTWARE\Classes\Airpost.Url.mailto\shell\open]

[{{HKEY_ROOT}}\SOFTWARE\Classes\Airpost.Url.mailto\shell\open\command]
@="\"{{PATH_TO_ROOT_FOLDER}}\\Update.exe\" --processStart airpost.exe --process-start-args %1"


[{{HKEY_ROOT}}\SOFTWARE\Clients\Mail\Airpost]
@="Airpost"
"LocalizedString"="@{{PATH_TO_ROOT_FOLDER}}\\Update.exe,-123"

[{{HKEY_ROOT}}\SOFTWARE\Clients\Mail\Airpost\DefaultIcon]
@="{{PATH_TO_APP_FOLDER}}\\airpost.exe,1"

[{{HKEY_ROOT}}\SOFTWARE\Clients\Mail\Airpost\Capabilities]
"ApplicationName"="Airpost"
"ApplicationDescription"="A fast, modern mail client designed to help you boost your productivity."

[{{HKEY_ROOT}}\SOFTWARE\Clients\Mail\Airpost\Capabilities\StartMenu]
"Mail"="Airpost"

[{{HKEY_ROOT}}\SOFTWARE\Clients\Mail\Airpost\Capabilities\URLAssociations]
"mailto"="Airpost.Url.mailto"

[{{HKEY_ROOT}}\SOFTWARE\Clients\Mail\Airpost\Protocols]

[{{HKEY_ROOT}}\SOFTWARE\Clients\Mail\Airpost\Protocols\mailto]
@="URL:MailTo Protocol"

[{{HKEY_ROOT}}\SOFTWARE\Clients\Mail\Airpost\Protocols\mailto\DefaultIcon]
@="{{PATH_TO_APP_FOLDER}}\\airpost.exe,1"

[{{HKEY_ROOT}}\SOFTWARE\Clients\Mail\Airpost\Protocols\mailto\shell]

[{{HKEY_ROOT}}\SOFTWARE\Clients\Mail\Airpost\Protocols\mailto\shell\open]

[{{HKEY_ROOT}}\SOFTWARE\Clients\Mail\Airpost\Protocols\mailto\shell\open\command]
@="\"{{PATH_TO_ROOT_FOLDER}}\\Update.exe\" --processStart airpost.exe --process-start-args %1"

[{{HKEY_ROOT}}\SOFTWARE\Clients\Mail\Airpost\shell]

[{{HKEY_ROOT}}\SOFTWARE\Clients\Mail\Airpost\shell\open]

[{{HKEY_ROOT}}\SOFTWARE\Clients\Mail\Airpost\shell\open\command]
@="\"{{PATH_TO_ROOT_FOLDER}}\\Update.exe\" --processStart airpost.exe"

[{{HKEY_ROOT}}\SOFTWARE\RegisteredApplications]
"Airpost"="Software\\Clients\\Mail\\Airpost\\Capabilities"


[HKEY_CURRENT_USER\SOFTWARE\Classes\Local Settings\Software\Microsoft\Windows\Shell\MuiCache]
"{{PATH_TO_ROOT_FOLDER}}\\Update.exe"="Airpost"
"{{PATH_TO_ROOT_FOLDER}}\\Update.exe.FriendlyAppName"="Airpost"
"{{PATH_TO_ROOT_FOLDER}}\\Update.exe.ApplicationCompany"="Airpost"
