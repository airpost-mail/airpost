{
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "project": "./tsconfig.json"
  },
  "globals": {
    "AppEnv": false,
    "$m": false,
    "waitsForPromise": false,
    "advanceClock": false,
    "TEST_ACCOUNT_ID": false,
    "TEST_ACCOUNT_NAME": false,
    "TEST_ACCOUNT_EMAIL": false,
    "TEST_ACCOUNT_ALIAS_EMAIL": false
  },
  "env": {
    "browser": true,
    "node": true,
    "jasmine": true
  },
  "plugins": ["react", "import", "jsx-a11y", "prettier"],
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/eslint-recommended",
    "plugin:@typescript-eslint/recommended",
    "prettier"
  ],
  "rules": {
    "no-cond-assign": 0,
    "no-console": 0,
    "no-constant-condition": "warn",
    "no-async-promise-executor": "warn",
    "import/first": 0,
    "prettier/prettier": "error",
    "import/no-dynamic-require": 0,
    "import/no-mutable-exports": 0,
    "jsx-a11y/tabindex-no-positive": "error",
    "jsx-a11y/label-has-associated-control": [
      "error",
      {
        "labelComponents": [],
        "labelAttributes": [],
        "controlComponents": [],
        "assert": "either",
        "depth": 3
      }
    ],
    "@typescript-eslint/explicit-member-accessibility": 0,
    "@typescript-eslint/no-explicit-any": 0,
    "@typescript-eslint/explicit-function-return-type": 0,
    "@typescript-eslint/prefer-interface": 0,
    "@typescript-eslint/no-unused-vars": 0,
    "@typescript-eslint/camelcase": 0,
    "@typescript-eslint/no-namespace": 0,
    "@typescript-eslint/no-use-before-define": 0,
    "@typescript-eslint/interface-name-prefix": 0,
    "@typescript-eslint/no-var-requires": 0,
    "@typescript-eslint/no-empty-interface": 0,
    "@typescript-eslint/class-name-casing": 0,
    "@typescript-eslint/prefer-namespace-keyword": 0,
    "@typescript-eslint/no-object-literal-type-assertion": 0,
    "@typescript-eslint/array-type": 0,
    "@typescript-eslint/explicit-module-boundary-types": 0,
    "@typescript-eslint/no-empty-function": 0,
    "@typescript-eslint/ban-types": "warn",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "@electron/remote",
            "message": "@electron/remote is a sync IPC round trip into any main-process object (docs/tech-debt.md TD35); add a typed ipcRenderer channel instead."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "error",
      {
        "selector": "CallExpression[callee.name='require'][arguments.0.value='@electron/remote']",
        "message": "@electron/remote is a sync IPC round trip into any main-process object (docs/tech-debt.md TD35); add a typed ipcRenderer channel instead."
      }
    ]
  },
  "settings": {
    "import/resolver": {
      "node": { "extensions": [".js", ".jsx", ".ts", ".tsx", ".json"] }
    },
    "import/extensions": [".js", ".jsx", ".ts", ".tsx"],
    "import/parsers": { "@typescript-eslint/parser": [".ts", ".tsx"] },
    "import/core-modules": [
      "mailspring-exports",
      "mailspring-component-kit",
      "electron",
      "mailspring-store",
      "mailspring-observables"
    ]
  },
  "overrides": [
    {
      "files": [
        "plugins/composer-templates/lib/preferences-templates.tsx",
        "plugins/composer-templates/lib/template-store.ts",
        "plugins/translation/lib/message-header.tsx",
        "spec/features/main-calendar/calendar-delete-exception-spec.ts",
        "spec/features/main-calendar/calendar-rsvp-spec.ts",
        "spec/features/main-calendar/calendar-selection-follows-move-spec.tsx",
        "spec/features/main-calendar/recurring-event-actions-spec.ts",
        "spec/features/notifications/update-notification-spec.tsx",
        "src/components/attachment-items.tsx",
        "src/components/composer-editor/grammar-check-plugins.tsx",
        "src/components/evented-iframe.tsx",
        "src/components/outline-view-item.tsx",
        "src/components/participants-text-field.tsx",
        "src/components/sheets/sheet-toolbar.tsx",
        "src/components/tokenizing-text-field.tsx",
        "src/features/account-sidebar/components/account-switcher.tsx",
        "src/features/account-sidebar/sidebar-item.ts",
        "src/features/composer-signature/preferences-signatures.tsx",
        "src/features/composer/composer-view.tsx",
        "src/features/contacts/ContactFiles.ts",
        "src/features/contacts/ContactList.tsx",
        "src/features/contacts/ContactListContextMenu.ts",
        "src/features/contacts/GoogleSupport.ts",
        "src/features/contacts/index.tsx",
        "src/features/list-unsubscribe/unsubscribe-service.ts",
        "src/features/main-calendar/core/calendar-event-context-menu.ts",
        "src/features/main-calendar/core/calendar-rsvp.ts",
        "src/features/main-calendar/core/calendar-view.tsx",
        "src/features/main-calendar/core/event-attendees-input.tsx",
        "src/features/main-calendar/core/recurring-event-dialog.ts",
        "src/features/message-list/message-controls.tsx",
        "src/features/message-list/message-item-body.tsx",
        "src/features/message-list/message-list.tsx",
        "src/features/message-list/message-participants.tsx",
        "src/features/notifications/items/default-client-notif.tsx",
        "src/features/notifications/items/update-notification.tsx",
        "src/features/onboarding/decorators/create-page-for-form.tsx",
        "src/features/preferences/tabs/mcp/tern-mcp.ts",
        "src/features/preferences/tabs/preferences-account-details.tsx",
        "src/features/preferences/tabs/preferences-appearance.tsx",
        "src/features/preferences/tabs/preferences-general.tsx",
        "src/features/preferences/tabs/preferences-keymaps.tsx",
        "src/features/print/print-window.ts",
        "src/features/system-tray/system-tray-icon-store.ts",
        "src/features/thread-list/thread-list-context-menu.ts",
        "src/flux/engine-bridge.ts",
        "src/flux/stores/attachment-store.ts",
        "src/flux/stores/database-store.ts",
        "src/flux/stores/message-store.ts",
        "src/main/app-window.ts",
        "src/main/auxiliary-window-guard.ts",
        "src/platform/system-start-service.ts",
        "src/plugin-host/package-manager.ts",
        "src/quickpreview/index.ts",
        "src/shared/default-client-helper.ts",
        "src/shared/engine-process.ts",
        "src/window/app-env.ts",
        "src/window/spellchecker.ts",
        "src/window/window-event-handler.ts"
      ],
      "rules": {
        "no-restricted-imports": "off",
        "no-restricted-syntax": "off"
      }
    },
    {
      "files": ["src/**", "plugins/**", "themes/**"],
      "rules": {
        "import/no-extraneous-dependencies": [
          "error",
          {
            "packageDir": ".",
            "devDependencies": ["**/spec/**", "**/specs/**"],
            "optionalDependencies": true,
            "peerDependencies": false
          }
        ]
      }
    },
    {
      "files": ["src/**", "plugins/**", "themes/**"],
      "excludedFiles": ["src/main/**", "**/specs/**"],
      "rules": {
        "import/no-restricted-paths": [
          "error",
          {
            "zones": [
              {
                "target": ".",
                "from": "./src/main",
                "message": "src/main/ is main-process code; window code reaches it over IPC. Code both processes load goes in src/shared/."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/main/**", "src/shared/**"],
      "rules": {
        "import/no-restricted-paths": [
          "error",
          {
            "zones": [
              {
                "target": ".",
                "from": "./src",
                "except": [
                  "./main",
                  "./shared",
                  "./flux/models/utils.ts",
                  "./registries/database-object-registry.ts",
                  "./registries/serializable-registry.ts"
                ],
                "message": "The main process loads src/main/ and src/shared/ only (plus flux/models/utils and the two registries it pulls in)."
              },
              {
                "target": ".",
                "from": ["./plugins", "./themes"],
                "message": "The main process doesn't load packages."
              }
            ]
          }
        ]
      }
    }
  ]
}
