{
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "project": ["./tsconfig.json", "./tests/tsconfig.json"]
  },
  "globals": {
    "AppEnv": false,
    "$m": false,
    "waitsForPromise": false,
    "advanceClock": false,
    "TEST_ACCOUNT_ID": false,
    "TEST_ACCOUNT_NAME": false,
    "TEST_ACCOUNT_EMAIL": false,
    "TEST_ACCOUNT_ALIAS_EMAIL": false
  },
  "env": {
    "browser": true,
    "node": true,
    "jasmine": true
  },
  "plugins": ["react", "import", "jsx-a11y", "prettier"],
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/eslint-recommended",
    "plugin:@typescript-eslint/recommended",
    "prettier"
  ],
  "rules": {
    "no-cond-assign": 0,
    "no-console": 0,
    "no-constant-condition": "warn",
    "no-async-promise-executor": "warn",
    "import/first": 0,
    "prettier/prettier": "error",
    "import/no-dynamic-require": 0,
    "import/no-mutable-exports": 0,
    "jsx-a11y/tabindex-no-positive": "error",
    "jsx-a11y/label-has-associated-control": [
      "error",
      {
        "labelComponents": [],
        "labelAttributes": [],
        "controlComponents": [],
        "assert": "either",
        "depth": 3
      }
    ],
    "@typescript-eslint/explicit-member-accessibility": 0,
    "@typescript-eslint/no-explicit-any": 0,
    "@typescript-eslint/explicit-function-return-type": 0,
    "@typescript-eslint/prefer-interface": 0,
    "@typescript-eslint/no-unused-vars": 0,
    "@typescript-eslint/camelcase": 0,
    "@typescript-eslint/no-namespace": 0,
    "@typescript-eslint/no-use-before-define": 0,
    "@typescript-eslint/interface-name-prefix": 0,
    "@typescript-eslint/no-var-requires": 0,
    "@typescript-eslint/no-empty-interface": 0,
    "@typescript-eslint/class-name-casing": 0,
    "@typescript-eslint/prefer-namespace-keyword": 0,
    "@typescript-eslint/no-object-literal-type-assertion": 0,
    "@typescript-eslint/array-type": 0,
    "@typescript-eslint/explicit-module-boundary-types": 0,
    "@typescript-eslint/no-empty-function": 0,
    "@typescript-eslint/ban-types": "warn",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "@electron/remote",
            "message": "Tern code reaches main-process APIs through src/platform/app-api.ts (channels in app-api-channels.ts); @electron/remote stays installed only for v1 plugins."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "error",
      {
        "selector": "CallExpression[callee.name='require'][arguments.0.value='@electron/remote']",
        "message": "Tern code reaches main-process APIs through src/platform/app-api.ts (channels in app-api-channels.ts); @electron/remote stays installed only for v1 plugins."
      }
    ]
  },
  "settings": {
    "import/resolver": {
      "node": { "extensions": [".js", ".jsx", ".ts", ".tsx", ".json"] }
    },
    "import/extensions": [".js", ".jsx", ".ts", ".tsx"],
    "import/parsers": { "@typescript-eslint/parser": [".ts", ".tsx"] },
    "import/core-modules": [
      "mailspring-exports",
      "mailspring-component-kit",
      "electron",
      "mailspring-store",
      "mailspring-observables"
    ]
  },
  "overrides": [
    {
      "files": [
        "plugins/composer-templates/lib/preferences-templates.tsx",
        "plugins/composer-templates/lib/store.ts",
        "plugins/translation/lib/message-header.tsx",
        "src/components/attachment-items.tsx",
        "src/components/composer-editor/grammar-check-plugins.tsx",
        "src/components/evented-iframe.tsx",
        "src/components/outline-view-item.tsx",
        "src/components/participants-text-field.tsx",
        "src/components/sheets/toolbar.tsx",
        "src/components/tokenizing-text-field.tsx",
        "src/features/account-sidebar/account-switcher.tsx",
        "src/features/account-sidebar/sidebar-item.ts",
        "src/features/composer-signature/preferences-signatures.tsx",
        "src/features/composer/view.tsx",
        "src/features/contacts/files.ts",
        "src/features/contacts/list.tsx",
        "src/features/contacts/list-context-menu.ts",
        "src/features/contacts/google-support.ts",
        "src/features/contacts/index.tsx",
        "src/features/list-unsubscribe/service.ts",
        "src/features/main-calendar/event/context-menu.ts",
        "src/features/main-calendar/event/rsvp.ts",
        "src/features/main-calendar/main-calendar.tsx",
        "src/features/main-calendar/event/attendees-input.tsx",
        "src/features/main-calendar/event/recurring-dialog.ts",
        "src/features/message-list/message-controls.tsx",
        "src/features/message-list/message-item-body.tsx",
        "src/features/message-list/message-list.tsx",
        "src/features/message-list/message-participants.tsx",
        "src/features/notifications/items/default-client.tsx",
        "src/features/notifications/items/update.tsx",
        "src/features/onboarding/pages/create-page-for-form.tsx",
        "src/features/preferences/tabs/mcp/tern-mcp.ts",
        "src/features/preferences/tabs/accounts/details.tsx",
        "src/features/preferences/tabs/appearance.tsx",
        "src/features/preferences/tabs/general.tsx",
        "src/features/preferences/tabs/keymaps/keymaps.tsx",
        "src/features/print/window.ts",
        "src/features/system-tray/icon-store.ts",
        "src/features/thread-list/context-menu.ts"
      ],
      "rules": {
        "no-restricted-imports": "off",
        "no-restricted-syntax": "off"
      }
    },
    {
      "files": ["src/**", "plugins/**", "themes/**", "tests/**"],
      "rules": {
        "import/no-extraneous-dependencies": [
          "error",
          {
            "packageDir": ".",
            "devDependencies": ["tests/**", "**/tests/**", "**/specs/**"],
            "optionalDependencies": true,
            "peerDependencies": false
          }
        ]
      }
    },
    {
      "files": ["src/**", "plugins/**", "themes/**"],
      "excludedFiles": [
        "src/main/**",
        "src/engine/supervisor/**",
        "src/config/migrator.ts",
        "src/config/persistence-manager.ts",
        "**/tests/**"
      ],
      "rules": {
        "import/no-restricted-paths": [
          "error",
          {
            "zones": [
              {
                "target": ".",
                "from": [
                  "./src/main",
                  "./src/engine/supervisor",
                  "./src/config/migrator.ts",
                  "./src/config/persistence-manager.ts"
                ],
                "message": "src/main/, src/engine/supervisor/ and the config migrator and persistence manager are main-process code; window code reaches them over IPC. Code both processes load is listed in the main-process override: src/intl/, src/platform/, src/config/, the src/engine/ root and single files in packages/, mail/, window/ and utils/."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/main/**",
        "src/config/**",
        "src/engine/*.ts",
        "src/engine/supervisor/**",
        "src/intl/**",
        "src/platform/**",
        "src/packages/bundled-packages.ts",
        "src/mail/attachment-safety.ts",
        "src/mail/content-security-policy.ts",
        "src/mail/files-scheme.ts",
        "src/mail/frame/protocol.ts",
        "src/window/external-fetch.ts",
        "src/utils/file-url.ts",
        "src/utils/fs.ts"
      ],
      "rules": {
        "import/no-restricted-paths": [
          "error",
          {
            "zones": [
              {
                "target": ".",
                "from": "./src",
                "except": [
                  "./main",
                  "./config",
                  "./engine/protocol.ts",
                  "./engine/process.ts",
                  "./engine/channels.ts",
                  "./engine/resurfacing.ts",
                  "./engine/supervisor",
                  "./intl",
                  "./platform",
                  "./packages/bundled-packages.ts",
                  "./mail/attachment-safety.ts",
                  "./mail/content-security-policy.ts",
                  "./mail/files-scheme.ts",
                  "./mail/frame/protocol.ts",
                  "./window/external-fetch.ts",
                  "./utils/file-url.ts",
                  "./utils/fs.ts",
                  "./data/models/utils.ts",
                  "./data/database-object-registry.ts",
                  "./data/serializable-registry.ts"
                ],
                "message": "The main process loads src/main/, src/config/, src/engine/supervisor/, src/intl/, src/platform/, the src/engine/ root and the single files listed here in packages/, mail/, window/ and utils/ (plus data/models/utils and the two registries it pulls in)."
              },
              {
                "target": ".",
                "from": ["./plugins", "./themes"],
                "message": "The main process doesn't load packages."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["tests/**", "plugins/*/tests/**"],
      "rules": {
        "no-restricted-imports": "off",
        "no-restricted-syntax": "off"
      }
    },
    {
      "files": ["src/**/*.tsx", "plugins/**/*.tsx", "themes/**/*.tsx"],
      "excludedFiles": ["src/components/kit/**", "**/tests/**"],
      "rules": {
        "raw-controls": "warn"
      }
    },
    {
      "files": ["tests/support/runner/**"],
      "rules": {
        "@typescript-eslint/no-this-alias": "off"
      }
    }
  ]
}
