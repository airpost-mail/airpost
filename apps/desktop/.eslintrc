{
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "project": "./app/tsconfig.json"
  },
  "globals": {
    "AppEnv": false,
    "$m": false,
    "waitsForPromise": false,
    "advanceClock": false,
    "TEST_ACCOUNT_ID": false,
    "TEST_ACCOUNT_NAME": false,
    "TEST_ACCOUNT_EMAIL": false,
    "TEST_ACCOUNT_ALIAS_EMAIL": false
  },
  "env": {
    "browser": true,
    "node": true,
    "jasmine": true
  },
  "plugins": ["react", "import", "jsx-a11y", "prettier"],
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/eslint-recommended",
    "plugin:@typescript-eslint/recommended",
    "prettier"
  ],
  "rules": {
    "no-cond-assign": 0,
    "no-console": 0,
    "no-constant-condition": "warn",
    "no-async-promise-executor": "warn",
    "import/first": 0,
    "prettier/prettier": "error",
    "import/no-dynamic-require": 0,
    "import/no-mutable-exports": 0,
    "jsx-a11y/tabindex-no-positive": "error",
    "jsx-a11y/label-has-associated-control": [
      "error",
      {
        "labelComponents": [],
        "labelAttributes": [],
        "controlComponents": [],
        "assert": "either",
        "depth": 3
      }
    ],
    "@typescript-eslint/explicit-member-accessibility": 0,
    "@typescript-eslint/no-explicit-any": 0,
    "@typescript-eslint/explicit-function-return-type": 0,
    "@typescript-eslint/prefer-interface": 0,
    "@typescript-eslint/no-unused-vars": 0,
    "@typescript-eslint/camelcase": 0,
    "@typescript-eslint/no-namespace": 0,
    "@typescript-eslint/no-use-before-define": 0,
    "@typescript-eslint/interface-name-prefix": 0,
    "@typescript-eslint/no-var-requires": 0,
    "@typescript-eslint/no-empty-interface": 0,
    "@typescript-eslint/class-name-casing": 0,
    "@typescript-eslint/prefer-namespace-keyword": 0,
    "@typescript-eslint/no-object-literal-type-assertion": 0,
    "@typescript-eslint/array-type": 0,
    "@typescript-eslint/explicit-module-boundary-types": 0,
    "@typescript-eslint/no-empty-function": 0,
    "@typescript-eslint/ban-types": "warn",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "@electron/remote",
            "message": "@electron/remote is a sync IPC round trip into any main-process object (docs/tech-debt.md TD35); add a typed ipcRenderer channel instead."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "error",
      {
        "selector": "CallExpression[callee.name='require'][arguments.0.value='@electron/remote']",
        "message": "@electron/remote is a sync IPC round trip into any main-process object (docs/tech-debt.md TD35); add a typed ipcRenderer channel instead."
      }
    ]
  },
  "settings": {
    "import/core-modules": [
      "mailspring-exports",
      "mailspring-component-kit",
      "electron",
      "mailspring-store",
      "mailspring-observables"
    ]
  },
  "overrides": [
    {
      "files": [
        "app/internal_packages/account-sidebar/lib/components/account-switcher.tsx",
        "app/internal_packages/account-sidebar/lib/sidebar-item.ts",
        "app/internal_packages/composer-signature/lib/preferences-signatures.tsx",
        "app/internal_packages/composer-templates/lib/preferences-templates.tsx",
        "app/internal_packages/composer-templates/lib/template-store.ts",
        "app/internal_packages/composer/lib/composer-view.tsx",
        "app/internal_packages/contacts/lib/ContactFiles.ts",
        "app/internal_packages/contacts/lib/ContactList.tsx",
        "app/internal_packages/contacts/lib/ContactListContextMenu.ts",
        "app/internal_packages/contacts/lib/GoogleSupport.ts",
        "app/internal_packages/contacts/lib/main.tsx",
        "app/internal_packages/list-unsubscribe/lib/unsubscribe-service.ts",
        "app/internal_packages/main-calendar/lib/core/calendar-event-context-menu.ts",
        "app/internal_packages/main-calendar/lib/core/calendar-rsvp.ts",
        "app/internal_packages/main-calendar/lib/core/event-attendees-input.tsx",
        "app/internal_packages/main-calendar/lib/core/mailspring-calendar.tsx",
        "app/internal_packages/main-calendar/lib/core/recurring-event-dialog.ts",
        "app/internal_packages/message-list/lib/message-controls.tsx",
        "app/internal_packages/message-list/lib/message-item-body.tsx",
        "app/internal_packages/message-list/lib/message-list.tsx",
        "app/internal_packages/message-list/lib/message-participants.tsx",
        "app/internal_packages/notifications/lib/items/default-client-notif.tsx",
        "app/internal_packages/notifications/lib/items/update-notification.tsx",
        "app/internal_packages/notifications/specs/update-notification-spec.tsx",
        "app/internal_packages/onboarding/lib/decorators/create-page-for-form.tsx",
        "app/internal_packages/preferences/lib/tabs/mcp/tern-mcp.ts",
        "app/internal_packages/preferences/lib/tabs/preferences-account-details.tsx",
        "app/internal_packages/preferences/lib/tabs/preferences-appearance.tsx",
        "app/internal_packages/preferences/lib/tabs/preferences-general.tsx",
        "app/internal_packages/preferences/lib/tabs/preferences-keymaps.tsx",
        "app/internal_packages/print/lib/print-window.ts",
        "app/internal_packages/system-tray/lib/system-tray-icon-store.ts",
        "app/internal_packages/thread-list/lib/thread-list-context-menu.ts",
        "app/internal_packages/translation/lib/message-header.tsx",
        "app/src/app-env.ts",
        "app/src/browser/auxiliary-window-guard.ts",
        "app/src/browser/mailspring-window.ts",
        "app/src/components/attachment-items.tsx",
        "app/src/components/composer-editor/grammar-check-plugins.tsx",
        "app/src/components/evented-iframe.tsx",
        "app/src/components/outline-view-item.tsx",
        "app/src/components/participants-text-field.tsx",
        "app/src/components/tokenizing-text-field.tsx",
        "app/src/default-client-helper.ts",
        "app/src/flux/mailsync-bridge.ts",
        "app/src/flux/stores/attachment-store.ts",
        "app/src/flux/stores/database-store.ts",
        "app/src/flux/stores/message-store.ts",
        "app/src/mailsync-process.ts",
        "app/src/package-manager.ts",
        "app/src/quickpreview/index.ts",
        "app/src/sheet-toolbar.tsx",
        "app/src/spellchecker.ts",
        "app/src/system-start-service.ts",
        "app/src/window-event-handler.ts"
      ],
      "rules": {
        "no-restricted-imports": "off",
        "no-restricted-syntax": "off"
      }
    }
  ]
}
