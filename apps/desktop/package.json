{
  "name": "tern",
  "productName": "Tern",
  "desktopName": "com.ternmail.tern.desktop",
  "version": "1.26.0",
  "description": "The best email app for people and teams at work",
  "author": "Tern contributors",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ternmail/ternmail.git"
  },
  "commitHash": "COMMIT_INSERTED_DURING_PACKAGING",
  "main": "./src/main/main.js",
  "engines": {
    "node": ">=22.12",
    "npm": ">=8"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "start": "electron . --enable-logging --dev",
    "lint": "eslint --fix -c .eslintrc --rulesdir scripts/eslint-rules \"src/**/*.{ts,tsx}\" \"{plugins,themes}/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" && eslint --no-eslintrc --no-error-on-unmatched-pattern -c scripts/eslint-no-remote.json \"src/**/*.js\" \"static/**/*.js\" \"plugins/**/*.js\"",
    "lint:check": "eslint -c .eslintrc --rulesdir scripts/eslint-rules \"src/**/*.{ts,tsx}\" \"{plugins,themes}/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" && eslint --no-eslintrc --no-error-on-unmatched-pattern -c scripts/eslint-no-remote.json \"src/**/*.js\" \"static/**/*.js\" \"plugins/**/*.js\"",
    "typecheck": "./node_modules/.bin/tsc -p tsconfig.json --noEmit && ./node_modules/.bin/tsc -p tests/tsconfig.json --noEmit && node scripts/check-plugin-api-dts.js",
    "check:native": "node scripts/check-native-abi.js",
    "test": "node scripts/test.js --test",
    "test-window": "node scripts/test.js --test=window",
    "tsc-watch": "tsc -w -p . --noEmit",
    "build": "node build/build.js"
  },
