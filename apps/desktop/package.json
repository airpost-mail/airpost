{
  "name": "tern-root",
  "version": "0.0.1",
  "description": "Packages required to develop and build Tern",
  "author": "Tern contributors",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ternmail/ternmail.git"
  },
  "engines": {
    "node": ">=22.12",
    "npm": ">=8"
  },
  "dependencies": {
    "@electron/packager": "^20.0.1",
    "@types/better-sqlite3": "^7.6.3",
    "@types/debug": "^4.1.2",
    "@types/event-kit": "^2.4.0",
    "@types/jasmine": "^1.3.1",
    "@types/mousetrap": "^1.6.1",
    "@types/optimist": "^0.0.29",
    "@types/proxyquire": "^1.3.28",
    "@types/react": "^17.0.0",
    "@types/react-color": "^2.14.1",
    "@types/react-dom": "^17.0.0",
    "@types/react-test-renderer": "^17.0.0",
    "@types/react-transition-group": "4.4.12",
    "@types/reflux": "^6.4.2",
    "@types/rx-lite": "^4.0.6",
    "@types/slate": "^0.44.10",
    "@types/slate-html-serializer": "^0.6.3",
    "@types/slate-plain-serializer": "^0.6.1",
    "@types/slate-react": "^0.22.1",
    "@types/source-map-support": "^0.4.2",
    "@types/underscore": "^1.8.9",
    "@types/underscore.string": "^0.0.33",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "better-sqlite3": "^12.8.0",
    "electron": "44.5.1",
    "electron-winstaller": "5.4.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-react": "^7.33.0",
    "fs-extra": "2.x.x",
    "fs-plus": "2.x.x",
    "glob": "7.x.x",
    "node-gyp": "^12.2.0",
    "playwright": "^1.59.1",
    "prettier": "^3.0.0",
    "rimraf": "^2.6.1",
    "typescript": "5.7.3",
    "underscore": "^1.13.1"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "start": "electron ./app --enable-logging --dev",
    "lint": "eslint --fix -c .eslintrc \"app/src/**/*.{ts,tsx}\" \"app/{features,plugins,themes}/**/*.{ts,tsx}\"",
    "lint:check": "eslint -c .eslintrc \"app/src/**/*.{ts,tsx}\" \"app/{features,plugins,themes}/**/*.{ts,tsx}\"",
    "typecheck": "./node_modules/.bin/tsc -p app/tsconfig.json --noEmit && node scripts/check-plugin-api-dts.js",
    "check:native": "node scripts/check-native-abi.js",
    "test": "node scripts/test.js --test",
    "test-window": "node scripts/test.js --test=window",
    "tsc-watch": "tsc -w -p ./app --noEmit",
    "build": "node build/build.js"
  },
  "overrides": {
    "tar": "7.5.21"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "electron-winstaller@5.4.0": true
  }
}
