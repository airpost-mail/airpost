#!/bin/bash
# mkdeb version arch control-file-path desktop-file-path icon-file-path sources-file-path deb-file-path

set -e

SCRIPT=`readlink -f "$0"`
ROOT=`readlink -f $(dirname $SCRIPT)/..`
cd $ROOT

VERSION="$1"
ARCH="$2"
ICON_FILE="$3"
LINUX_ASSETS_DIRECTORY="$4"
APP_CONTENTS_DIRECTORY="$5"
OUTPUT_PATH="$6"

FILE_MODE=755

TARGET_ROOT="`mktemp -d`"
chmod $FILE_MODE "$TARGET_ROOT"
TARGET="$TARGET_ROOT/tern-$VERSION-$ARCH"

mkdir -m $FILE_MODE -p "$TARGET/usr"
mkdir -m $FILE_MODE -p "$TARGET/usr/share"
cp -r "$APP_CONTENTS_DIRECTORY" "$TARGET/usr/share/tern"
chmod +rx "$TARGET/usr/share/tern"

mkdir -m $FILE_MODE -p "$TARGET/DEBIAN"
cp "$OUTPUT_PATH/control" "$TARGET/DEBIAN/control"

cp "$LINUX_ASSETS_DIRECTORY/debian/postinst" "$TARGET/DEBIAN/postinst"
cp "$LINUX_ASSETS_DIRECTORY/debian/postrm" "$TARGET/DEBIAN/postrm"

mkdir -m $FILE_MODE -p "$TARGET/usr/bin"
# "ternmail", not "tern": that is the CLI (apps/cli), which may be installed alongside.
ln -s "../share/tern/tern" "$TARGET/usr/bin/ternmail"
chmod +x "$TARGET/usr/bin/ternmail"

mkdir -m $FILE_MODE -p "$TARGET/usr/share/applications"
cp "$OUTPUT_PATH/com.ternmail.tern.desktop" "$TARGET/usr/share/applications"
mkdir -m $FILE_MODE -p "$TARGET/usr/share/metainfo"
cp "$OUTPUT_PATH/com.ternmail.tern.metainfo.xml" "$TARGET/usr/share/metainfo"

mkdir -m $FILE_MODE -p "$TARGET/usr/share/pixmaps"
cp "$ICON_FILE" "$TARGET/usr/share/pixmaps/tern.png"

mkdir -m $FILE_MODE -p "$TARGET/usr/share/icons/hicolor"
for i in 256 128 64 32 16; do
  mkdir -p "$TARGET/usr/share/icons/hicolor/${i}x${i}/apps"
  cp "$LINUX_ASSETS_DIRECTORY/icons/tern-${i}.png" "$TARGET/usr/share/icons/hicolor/${i}x${i}/apps/com.ternmail.tern.png"
done

# Tern's notice and licence (written into resources/ by build/generate-licenses.js). The
# third-party licences are in resources/app.asar.unpacked/static/all_licenses.html.
mkdir -m $FILE_MODE -p "$TARGET/usr/share/doc/tern"
cat "$TARGET/usr/share/tern/resources/NOTICE.md" "$TARGET/usr/share/tern/resources/LICENSE.md" \
  > "$TARGET/usr/share/doc/tern/copyright"

# Add lintian overrides
mkdir -m $FILE_MODE -p "$TARGET/usr/share/lintian/overrides"
cp "$ROOT/build/resources/linux/debian/lintian-overrides" "$TARGET/usr/share/lintian/overrides/tern"

# Remove group write from all files
chmod -R g-w "$TARGET";

# Remove execstack bit from tern executable (execstack is x86-only, skip on other archs)
if command -v execstack &> /dev/null; then
  execstack --clear-execstack "$TARGET/usr/share/tern/tern"
fi

# Remove executable bit from .node files
find "$TARGET" -type f -name "*.node" -exec chmod a-x {} \;

fakeroot dpkg-deb -b "$TARGET"
mv "$TARGET_ROOT/tern-$VERSION-$ARCH.deb" "$OUTPUT_PATH"
rm -rf "$TARGET_ROOT"
