<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.ternmail.tern</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <name><%= productName %></name>
  <summary><%= description %></summary>
  <description>
    <p>
      Tern is an open source desktop email client with a unified inbox, snooze, send later,
      mail rules, templates, calendar and contacts. It is a fork of Mailspring with a new sync
      engine written in Rust.
    </p>
  </description>

  <url type="homepage">https://github.com/ternmail/ternmail</url>
  <url type="bugtracker">https://github.com/ternmail/ternmail/issues</url>
  <url type="vcs-browser">https://github.com/ternmail/ternmail</url>

  <launchable type="desktop-id"><%= desktopName %></launchable>

  <developer id="com.ternmail">
    <name>Tern contributors</name>
  </developer>

  <branding>
    <color type="primary" scheme_preference="light">#d7f0f8</color>
    <color type="primary" scheme_preference="dark">#0A1A3D</color>
  </branding>

  <content_rating type="oars-1.1" />

